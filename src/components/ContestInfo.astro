---
/**
 * 대회 정보 섹션. 세로로 스크롤하며 읽는 구성이다.
 *
 * 섹션마다 구조가 다르다 — 전부 같은 라운드 카드로 만들지 않는다.
 *   일정   시각 / 내용 두 열. 순서가 있는 유일한 콘텐츠라 번호를 붙인다
 *   장소   짧으므로 카드 없이 한 줄
 *   대상   세 항목 나열
 *   규칙   허용과 금지를 나눠 배치하고 금지를 두드러지게 한다
 *   상금   금액 내림차순이 크기로 드러나는 표. 대상만 gold
 *   지난 대회 사진. 장수에 따라 배치가 바뀐다 (PastGallery.astro)
 *
 * 배경은 전부 흰색이다. 섹션마다 배경색을 바꾸지 않는다.
 * 각 정보 섹션은 Motion JS가 한 번만 아래에서 드러내며, 기본 HTML은 항상 보인다.
 */
import NoticeBox from './NoticeBox.astro';
import PastGallery from './PastGallery.astro';
import VenueMap from './VenueMap.astro';
import {
  CONTEST_DATE,
  ELIGIBILITY,
  ELIGIBILITY_NOTICE,
  PRIZES,
  PRIZE_GOODS_NOTE_INDEX,
  PRIZE_GOODS_RULES,
  PRIZE_GOODS_TITLE,
  PRIZE_NOTE,
  RULES,
  SCHEDULE,
  SECTION_ICON,
  VENUE,
} from '../data/contest';
---

<div class="info">
  {/* ── 1. 대회 일정 ───────────────────────────────── */}
  <section id="schedule" class="section" data-scroll-reveal>
    <h2 class="heading">
      <img class="heading__icon" src={SECTION_ICON.schedule} alt="" aria-hidden="true" />
      대회 일정
    </h2>
    <p class="section__lead">{CONTEST_DATE}</p>

    <ol class="timeline">
      {
        SCHEDULE.map((item, i) => (
          <li class="timeline__row">
            <span class="timeline__num" aria-hidden="true">{i + 1}</span>
            <span class="timeline__time">{item.time}</span>
            <span class="timeline__title">{item.title}</span>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── 2. 대회 장소 — 카드 없이 한 줄 ──────────────── */}
  <section id="venue" class="section" data-scroll-reveal>
    <h2 class="heading">
      <img class="heading__icon" src={SECTION_ICON.venue} alt="" aria-hidden="true" />
      대회 장소
    </h2>
    {/* 지도가 없어도 위치를 알 수 있어야 한다. 주소는 항상 표시된다. */}
    <p class="venue">{VENUE}</p>
    <VenueMap />
  </section>

  {/* ── 3. 참가 대상 ───────────────────────────────── */}
  <section id="eligibility" class="section" data-scroll-reveal>
    <h2 class="heading">
      <img class="heading__icon" src={SECTION_ICON.eligibility} alt="" aria-hidden="true" />
      참가 대상
    </h2>
    <ul class="targets">
      {ELIGIBILITY.map((item) => <li class="targets__item">{item}</li>)}
    </ul>

    {/* 자격 조건이 아니라 신청을 서두르라는 안내다. 목록 항목으로 넣으면
        명사형 세 줄 사이에 존댓말 한 줄이 섞인다. */}
    <NoticeBox label="참가 제한" text={ELIGIBILITY_NOTICE} />
  </section>

  {/* ── 4. 대회 규칙 — 허용 / 금지 구분 ─────────────── */}
  <section id="rules" class="section" data-scroll-reveal>
    <h2 class="heading">
      <img class="heading__icon" src={SECTION_ICON.rules} alt="" aria-hidden="true" />
      대회 규칙
    </h2>

    {/* 링크와 뒤 문장 사이에 개행을 두지 않는다. 공백이 하나 더 생긴다. */}
    <ul class="rules">
      {
        RULES.allowed.map((item) => (
          <li class="rules__item">
            {item.lead && (
              <a
                class="text-link"
                href={item.lead.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.lead.text}
              </a>
            )}{item.text}
          </li>
        ))
      }
    </ul>

    <NoticeBox label="금지" text={RULES.forbidden[0]} />
  </section>

  {/* ── 5. 대회 상금 ───────────────────────────────── */}
  <section id="prizes" class="section" data-scroll-reveal>
    <h2 class="heading">
      <img class="heading__icon" src={SECTION_ICON.prizes} alt="" aria-hidden="true" />
      대회 상금
    </h2>

    <table class="prizes">
      <caption class="sr-only">등급별 상금과 수상 팀 수</caption>
      <tbody>
        {
          PRIZES.map((p) => (
            <tr class:list={['prizes__row', p.top && 'prizes__row--top']}>
              <th scope="row" class="prizes__grade">{p.grade}</th>
              <td class="prizes__amount">{p.amount}</td>
              <td class="prizes__teams">{p.teams}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    {/* 항목당 한 줄이다. 배열을 <p> 하나에 그대로 넣으면 Astro 가 구분자 없이
        이어 붙여 네 문장이 한 줄로 흐른다. */}
    <div class="prizes__notes">
      {
        PRIZE_NOTE.map((note, i) => (
          <>
            <p class="prizes__note">{note}</p>
            {/* 부상 대체 지급 주석에만 붙는다. 현금 수상자에게는 해당하지 않는
                규정이라 표 아래 독립 항목으로 두면 전원에게 적용되는 것으로 읽힌다. */}
            {i === PRIZE_GOODS_NOTE_INDEX && (
              <details class="goods">
                <summary class="goods__summary">{PRIZE_GOODS_TITLE}</summary>
                <ul class="goods__list">
                  {PRIZE_GOODS_RULES.map((rule) => (
                    <li class="goods__item">
                      {rule.text}
                      {rule.sub && (
                        <ul class="goods__sublist">
                          {rule.sub.map((line) => <li class="goods__subitem">{line}</li>)}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </>
        ))
      }
    </div>
  </section>

  {/* ── 6. 지난 대회 사진 ──────────────────────────────
      정보를 다 읽고 신청 직전에 분위기를 전달하는 자리다.
      사진이 없으면 컴포넌트가 아무것도 렌더하지 않는다. */}
  <PastGallery />

  {/* ── 7. 참가 신청 ───────────────────────────────── */}
  <section id="apply" class="section section--apply" data-scroll-reveal>
    <h2 class="heading heading--plain">참가 신청</h2>
    <a class="apply-cta" href="https://forms.gle/uPfh6FU3BDJEsYd8A">구글폼으로 신청하기</a>
  </section>
</div>

<style>
  @reference '../styles/global.css';

  .info {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    /* 앵커 이동 시 제목이 sticky 네비게이션 뒤로 숨지 않게 한다. */
    scroll-margin-top: calc(var(--nav-h) + 1.25rem);
    padding: clamp(2.5rem, 6vh, 4.5rem) 0;
    border-bottom: 1px solid color-mix(in srgb, theme(colors.ink) 8%, transparent);
  }

  .section:last-child {
    border-bottom: 0;
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: clamp(1.25rem, 3.2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .heading__icon {
    width: 30px;
    height: 30px;
    object-fit: contain;
    flex: none;
  }

  .heading--plain {
    justify-content: center;
  }

  .section__lead {
    margin: 0.75rem 0 0;
    color: theme(colors.orange);
    font-size: 1rem;
    font-weight: 600;
    /* 날짜의 숫자 폭을 고르게 한다. 모노스페이스를 쓰지 않는다. */
    font-variant-numeric: tabular-nums;
  }

  /* ── 일정: 시각이 축으로 드러나는 두 열 ─────────────── */
  .timeline {
    margin: 1.0rem 0 0;
    padding: 0;
    list-style: none;

    /* 배지 지름 = 세 요소의 첫 줄 높이. 이 한 값으로 정렬을 맞춘다. */
    --row-line: 1.5rem;
    /* 시각 열 고정 폭. 네 행의 내용 시작점이 폰트 렌더링과 무관하게 일치한다. */
    --time-col: 8.5rem;
    --row-gap: 0.75rem;
  }

  /*
   * 배지 / 시각 / 내용 세 요소를 같은 기준으로 정렬한다.
   *
   * 세 요소의 첫 줄 높이를 모두 --row-line 으로 통일하고 align-items: flex-start
   * 로 위를 맞춘다. 그러면 배지 원의 중심이 첫 줄 상자의 중심과 정확히 겹치고,
   * 시각과 내용의 첫 줄 baseline 도 같은 줄에 놓인다.
   *
   * align-items: baseline 은 쓰지 않는다. 배지는 안쪽 숫자를 place-items 로
   * 중앙 정렬하므로 baseline 을 가진 자식이 없어, 브라우저가 테두리 상자에서
   * baseline 을 합성한다(원의 아래 끝이 기준선이 된다). 그 결과가 폰트·엔진에
   * 따라 달라져 이전에 원이 텍스트보다 아래로 내려가 있었다.
   */
  .timeline__row {
    display: flex;
    align-items: flex-start;
    gap: var(--row-gap);
    padding: 0.875rem 0;
    border-top: 1px solid color-mix(in srgb, theme(colors.ink) 8%, transparent);
  }

  .timeline__row:first-child {
    border-top: 0;
  }

  .timeline__num {
    flex: none;
    /* 고정 크기 원. 안의 숫자는 line-height 가 아니라 place-items 로 중앙에 온다. */
    display: grid;
    place-items: center;
    width: var(--row-line);
    height: var(--row-line);
    line-height: 1;
    border-radius: 9999px;
    background-color: color-mix(in srgb, theme(colors.orange) 12%, transparent);
    color: theme(colors.orange);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .timeline__time {
    flex: none;
    width: var(--time-col);
    /* 첫 줄 높이를 배지 지름과 같게 맞춘다. */
    line-height: var(--row-line);
    color: theme(colors.orange);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .timeline__title {
    flex: 1 1 auto;
    min-width: 0;
    line-height: var(--row-line);
    font-size: 1rem;
    font-weight: 500;
    word-break: keep-all;
  }

  /* ── 장소: 카드 없이 한 줄 ──────────────────────────── */
  .venue {
    margin: 1rem 0 0;
    font-size: clamp(1rem, 2.4vw, 1.125rem);
    font-weight: 500;
    word-break: keep-all;
  }

  /* ── 참가 대상: 세 항목 나열 ────────────────────────── */
  .targets {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.625rem;
  }

  .targets__item {
    position: relative;
    padding-left: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    word-break: keep-all;
  }

  /* 이모지를 쓰지 않는다. 목록 표식은 CSS 도형이다. */
  .targets__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 9999px;
    background-color: theme(colors.orange);
  }

  /* ── 규칙: 허용과 금지를 시각적으로 구분 ─────────────── */
  .rules {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.625rem;
  }

  .rules__item {
    position: relative;
    padding-left: 1.375rem;
    font-size: 1rem;
    line-height: 1.6;
    word-break: keep-all;
  }

  /* 허용 항목은 가벼운 체크 표식(도형)으로 둔다. */
  .rules__item::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.48em;
    width: 0.5rem;
    height: 0.28rem;
    border-left: 2px solid theme(colors.orange);
    border-bottom: 2px solid theme(colors.orange);
    transform: rotate(-45deg);
  }

  /* ── 상금: 금액 순서가 크기로 드러나는 표 ────────────── */
  .prizes {
    width: 100%;
    margin: 1.5rem 0 0;
    border-collapse: collapse;
  }

  .prizes__row {
    border-top: 1px solid color-mix(in srgb, theme(colors.ink) 8%, transparent);
  }

  .prizes__row:first-child {
    border-top: 0;
  }

  .prizes__grade,
  .prizes__amount,
  .prizes__teams {
    padding: 0.75rem 0;
    text-align: left;
  }

  .prizes__grade {
    width: 5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  /* 금액은 열을 맞춘다. 등급이 내려갈수록 글자도 작아져 순서가 크기로 읽힌다. */
  .prizes__amount {
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-weight: 700;
    font-size: 1.125rem;
    white-space: nowrap;
  }

  .prizes__teams {
    width: 4rem;
    padding-left: 1.25rem;
    color: color-mix(in srgb, theme(colors.ink) 60%, transparent);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .prizes__row:nth-child(2) .prizes__amount {
    font-size: 1.0625rem;
  }
  .prizes__row:nth-child(3) .prizes__amount {
    font-size: 1rem;
  }
  .prizes__row:nth-child(4) .prizes__amount {
    font-size: 0.9375rem;
  }

  /* 최상위 강조는 gold. 대상 한 줄에만 준다. */
  .prizes__row--top .prizes__grade,
  .prizes__row--top .prizes__amount {
    color: theme(colors.gold);
  }

  .prizes__row--top .prizes__amount {
    font-size: 1.375rem;
  }

  /* 주석 묶음. 표와의 간격은 여기서 한 번만 준다. */
  .prizes__notes {
    margin: 1.25rem 0 0;
  }

  .prizes__note {
    /* 줄 사이는 문장 간격보다 좁게 둔다. 네 줄이 한 묶음으로 읽혀야 한다. */
    margin: 0.375rem 0 0;
    color: color-mix(in srgb, theme(colors.ink) 70%, transparent);
    font-size: 0.9375rem;
    line-height: 1.6;
    word-break: keep-all;
    /* 내어쓰기. 줄이 길어 넘어갈 때 둘째 줄이 '* ' 뒤에 맞춰 들어간다.
       좁은 화면에서 넘치는 항목이 있으므로 없으면 별표와 본문이 뒤섞인다. */
    padding-left: 0.85em;
    text-indent: -0.85em;
  }

  .prizes__note:first-child {
    margin-top: 0;
  }

  /*
   * 부상 지급 세부 규정 — 네 번째 주석의 하위 항목.
   *
   * 주석보다 튀지 않아야 한다. 그래서 색은 주석(ink 70%)보다 더 옅게,
   * 글자는 더 작게 두고, 들여쓰기로 종속 관계를 드러낸다. 테두리나 배경을
   * 주지 않는다 — 상자를 만들면 주석과 같은 층위로 올라간다.
   *
   * <details> 는 네이티브라 JS 가 필요 없다.
   */
  .goods {
    /* 주석의 '* ' 뒤 글자가 시작하는 지점보다 한 단계 더 들여쓴다. */
    margin: 0.25rem 0 0 1.35em;
  }

  .goods__summary {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    width: fit-content;
    color: color-mix(in srgb, theme(colors.ink) 55%, transparent);
    font-size: 0.875rem;
    line-height: 1.6;
    cursor: pointer;
    /* 기본 삼각형을 지우고 아래 ::before 로 직접 그린다. 기본 마커는 브라우저마다
       크기와 여백이 달라 주석과의 정렬이 맞지 않는다. */
    list-style: none;
    transition: color 150ms ease;
  }

  .goods__summary::-webkit-details-marker {
    display: none;
  }

  .goods__summary::before {
    content: '';
    flex: none;
    width: 0;
    height: 0;
    /* 오른쪽을 향한 작은 삼각형. 펼치면 아래를 향한다. */
    border-top: 0.26em solid transparent;
    border-bottom: 0.26em solid transparent;
    border-left: 0.42em solid color-mix(in srgb, theme(colors.orange) 70%, transparent);
    transform: translateY(0.08em);
    transition: rotate 150ms ease;
  }

  .goods[open] > .goods__summary::before {
    rotate: 90deg;
  }

  .goods__summary:hover {
    color: color-mix(in srgb, theme(colors.ink) 75%, transparent);
  }

  .goods__summary:focus-visible {
    outline: 2px solid theme(colors.orange);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .goods__list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .goods__item {
    position: relative;
    margin: 0.3125rem 0 0;
    padding-left: 0.75em;
    color: color-mix(in srgb, theme(colors.ink) 60%, transparent);
    font-size: 0.8125rem;
    line-height: 1.65;
    word-break: keep-all;
  }

  .goods__item::before {
    content: '·';
    position: absolute;
    left: 0;
    color: color-mix(in srgb, theme(colors.ink) 40%, transparent);
  }

  /* 예시·단서 줄. 한 단계 더 들여쓰고 마커를 주지 않는다. */
  .goods__sublist {
    margin: 0.125rem 0 0;
    padding: 0;
    list-style: none;
  }

  .goods__subitem {
    color: color-mix(in srgb, theme(colors.ink) 48%, transparent);
    font-size: 0.8125rem;
    line-height: 1.65;
    word-break: keep-all;
  }

  /* ── 참가 신청 ─────────────────────────────────────── */
  .section--apply {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .apply-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 2.5rem;
    border-radius: 9999px;
    background-color: theme(colors.orange);
    color: theme(colors.paper);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .apply-cta:hover,
  .apply-cta:focus-visible {
    background-color: theme(colors.orange-title);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    /* 좁은 화면에서는 두 열이 다 들어가지 않는다.
       배지 + 시각을 첫 줄, 내용을 다음 줄에 두고 내용을 시각과 같은 x 에 맞춘다. */
    .timeline__row {
      flex-wrap: wrap;
