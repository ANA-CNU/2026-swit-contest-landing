---
/**
 * 지난 대회 사진.
 *
 * 자리
 *   '대회 상금' 과 '참가 신청' 사이. 정보를 다 읽고 신청 버튼을 누르기 직전이
 *   분위기 전달에 가장 효과적이다. 히어로에는 넣지 않는다.
 *
 * 배치는 장수와 무관하게 가로 스크롤 캐러셀 하나다. 예전에는 2~3장/4~6장/7장+
 * 로 나눠 나란히·2열·캐러셀로 갈랐는데, 병렬로 깔면 장당 작아지고 장수가 늘 때마다
 * 배치가 바뀌어 예측이 안 됐다. 캐러셀은 몇 장이 되든 장당 크기가 일정하다.
 *
 * 사진이 하나도 없으면 섹션 자체를 렌더하지 않는다. 빈 제목만 남으면 안 된다.
 *
 * 모션 없음. 진입 애니메이션도 hover 확대도 넣지 않는다 — 히어로의 분사가
 * 페이지의 유일한 모션이다. 라이트박스·모달도 만들지 않는다.
 */
import assets from '../data/assets.json';
import {
  GALLERY_ALT,
  GALLERY_ALT_FALLBACK,
  INSTAGRAM_URL,
  SECTION_ICON,
} from '../data/contest';

type Shot = { src: string; w: number; h: number; ratio: number };

const photos: Shot[] = (assets as Record<string, Shot[]>).gallery ?? [];

/** 파일명(확장자 제외). alt 조회와 object-position 예외 지정에 쓴다. */
const stem = (src: string) => src.split('/').pop()!.replace('.webp', '');

/**
 * 얼굴이 잘리는 사진만 여기에 적는다.
 *
 * 고정 비율 상자에 object-fit: cover 로 채우므로 기본값(center)이면 위아래가
 * 잘린다. 단체 사진은 인물이 가운데보다 위에 있는 경우가 많아 'center 35%'
 * 정도가 나을 때가 있다. 값은 CSS object-position 문법 그대로 쓴다.
 */
const FOCUS: Record<string, string> = {};

---

{
  photos.length > 0 && (
    <section id="gallery" class="section" data-scroll-reveal>
      <h2 class="heading">
        <img class="heading__icon" src={SECTION_ICON.gallery} alt="" aria-hidden="true" />
        지난 대회
      </h2>

      <ul class="shots">
        {photos.map((photo) => {
          const name = stem(photo.src);
          return (
            <li class="shots__item">
              {/*
                width/height 를 원본 픽셀 그대로 넣어 레이아웃 시프트를 막는다.
                실제 표시 크기는 CSS 가 정하고, 이 값은 비율 예약용이다.
              */}
              <img
                class="shot"
                src={photo.src}
                width={photo.w}
                height={photo.h}
                alt={GALLERY_ALT[name] ?? GALLERY_ALT_FALLBACK}
                loading="lazy"
                decoding="async"
                style={FOCUS[name] ? `object-position:${FOCUS[name]}` : undefined}
              />
            </li>
          );
        })}
      </ul>

      {/* TODO: 동아리 인스타그램 주소가 확정되면 contest.ts 의 INSTAGRAM_URL 을 교체한다. */}
      <a class="more" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        더 많은 사진 보기
      </a>
    </section>
  )
}

<style>
  @reference '../styles/global.css';

  /* ContestInfo 의 .section / .heading 과 같은 규칙을 쓴다. 스코프가 달라
     상속되지 않으므로 여기서 다시 선언한다. 값이 갈리면 안 된다. */
  .section {
    scroll-margin-top: calc(var(--nav-h) + 1.25rem);
    padding: clamp(2.5rem, 6vh, 4.5rem) 0;
    border-bottom: 1px solid color-mix(in srgb, theme(colors.ink) 8%, transparent);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: clamp(1.25rem, 3.2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .heading__icon {
    width: 30px;
    height: 30px;
    object-fit: contain;
    flex: none;
  }

  .shots {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  /*
   * 세로 사진과 가로 사진이 섞여도 줄이 흐트러지지 않게 상자 비율을 고정하고
   * object-fit: cover 로 채운다. 사진 원본 비율은 assets.json 에 남아 있으므로
   * 필요하면 개별 조정이 가능하다(위 FOCUS).
   */
  .shots__item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* 지도(VenueMap)와 같은 12px. 사진·지도 같은 매체 상자의 공통값이다. */
    border-radius: 12px;
    background-color: color-mix(in srgb, theme(colors.ink) 4%, transparent);
  }

  .shot {
    display: block;
    width: 100%;
    height: 100%;
    /* 필터를 걸지 않는다. 배경도 흰색 그대로 둔다. */
    object-fit: cover;
    object-position: center;
  }

  /*
   * 가로 스크롤 캐러셀.
   *
   * 스크롤 가능하다는 단서는 두 가지다 — 스크롤바가 보이고, 마지막 칸이 화면
   * 오른쪽에서 잘린다. 칸 폭을 % 로 잡아 끝이 딱 맞아떨어지지 않게 했다.
   * 오른쪽 가장자리에 흰 마스크도 걸었다가 걷어냈다. 사진을 지우는 대가에 비해
   * 얻는 단서가 없다.
   * scroll-snap 으로 한 장씩 걸리게 해 손가락 스크롤이 어정쩡하게 멈추지 않게 한다.
   */
  .shots {
    display: grid;
    grid-auto-flow: column;
    /* minmax(0, 72%) 로 쓰면 안 된다. 최솟값 0 이라 칸이 컨테이너 폭에 맞게
       쪼그라들어(실측 8장에서 75.5px) 넘치지 않고, 스크롤 자체가 생기지 않는다.
       고정 트랙 크기로 줘야 넘치고 스크롤이 생긴다. */
    grid-auto-columns: 72%;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* 스크롤바가 사진 아래에 붙지 않게 여유를 준다. */
    padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .shots__item {
    scroll-snap-align: start;
  }

  @media (min-width: 641px) {
    /* 넓은 화면에서는 한 화면에 더 담는다. 잘림 단서는 유지된다. */
    .shots {
      grid-auto-columns: 34%;
    }
  }

  /* 본문 인라인 링크(.text-link)와 다른 성격이라 버튼형으로 둔다.
     VenueMap 의 길찾기 버튼과 같은 형태다. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 1rem 0 0;
    padding: 0.5rem 1rem;
    border: 1px solid theme(colors.orange);
    border-radius: 9999px;
    color: theme(colors.orange);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .more::after {
    /* 새 탭으로 열린다는 표시. 도형이라 읽히지 않게 둔다. */
    content: '↗';
    font-size: 0.875em;
  }

  .more:hover {
    background-color: theme(colors.orange);
    color: theme(colors.paper);
  }

  .more:focus-visible {
    outline: 2px solid theme(colors.orange);
    outline-offset: 3px;
  }
</style>
