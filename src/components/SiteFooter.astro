---
/**
 * 푸터. 주최 표기와 로고 넷을 배치한다 — ANA, 충남대학교,
 * 소프트웨어중심대학사업단, COSS (CLAUDE.md "로고" 절).
 *
 * 로고 파일이 아직 없어 이름만 담은 플레이스홀더로 둔다.
 */
import { HOST, LOGOS } from '../data/contest';
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__host">
      <span class="footer__host-label">주최</span>
      {HOST}
    </p>

    {/* TODO: 로고 파일이 준비되면 각 자리를 <img> 로 교체한다.
        파일은 public/logos/ 에 두고 alt 에 기관명을 넣는다. */}
    <ul class="logos" aria-label="주최 및 후원 기관">
      {LOGOS.map((name) => <li class="logos__slot">{name}</li>)}
    </ul>

    <p class="footer__copy">SW-IT Contest 2026</p>
  </div>
</footer>

<style>
  @reference '../styles/global.css';

  .footer {
    /* 배경은 흰색이다. 섹션마다 배경색을 바꾸지 않는다. */
    border-top: 1px solid color-mix(in srgb, theme(colors.ink) 10%, transparent);
  }

  .footer__inner {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vh, 3rem) 1.5rem clamp(2.5rem, 6vh, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer__host {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    word-break: keep-all;
  }

  .footer__host-label {
    margin-right: 0.5rem;
    color: theme(colors.orange);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 로고 자리. 파일이 들어오면 이 박스 크기에 맞춘다. */
  .logos__slot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 8.5rem;
    height: 3rem;
    padding: 0 0.75rem;
    border: 1px dashed color-mix(in srgb, theme(colors.ink) 22%, transparent);
    border-radius: 0.5rem;
    color: color-mix(in srgb, theme(colors.ink) 55%, transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    word-break: keep-all;
  }

  .footer__copy {
    margin: 0;
    color: color-mix(in srgb, theme(colors.ink) 45%, transparent);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .logos__slot {
      min-width: 7rem;
      height: 2.75rem;
      font-size: 0.75rem;
    }
  }
</style>
