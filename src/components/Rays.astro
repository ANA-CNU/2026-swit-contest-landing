---
/**
 * 원점에서 방사되는 광선 레이어.
 *
 * 쐐기 15개. 각도·길이·폭·색은 전부 아래 상수 배열에 하드코딩이며 난수를 쓰지 않는다.
 *
 * SVG 를 쓰지 않는다. 스테이지가 고정 aspect-ratio 가 아니게 되어 뷰포트에 따라
 * 종횡비가 바뀌는데, viewBox + preserveAspectRatio="none" 으로 늘리면 쐐기 각도가
 * 함께 왜곡된다. CSS rotate 는 픽셀 공간에서 이뤄지므로 컨테이너 종횡비와 무관하게
 * 각도가 정확하다. 길이·폭도 오브젝트와 같은 대각선 기준을 쓰므로 어느 화면에서나
 * 광선과 오브젝트의 반경 축척이 일치한다.
 *
 * pixel_* 에셋은 쓰지 않는다. 광선만 남긴다.
 * (scripts/build-assets.py 는 계속 pixel WebP 를 생성한다. 참조만 없앤 것이다.)
 */
import { ORIGIN, TIMING } from '../data/hero-layout';

interface Wedge {
  /** 원점 기준 각도(deg). 오브젝트 부채꼴(-35 ~ 78)을 덮는다. */
  angle: number;
  /** 길이. 스테이지 대각선 대비 비율. 1.0 을 넘으면 화면 밖까지 뻗는다. */
  lenD: number;
  /** 끝단 폭의 절반. 대각선 대비 비율. 원점 쪽은 한 점으로 모인다. */
  halfD: number;
  /** orange 원색과 orange-soft 두 톤을 섞는다. */
  tone: 'orange' | 'soft';
  /** 시작 지연(ms). 오브젝트보다 먼저 끝난다. */
  delay: number;
}

/**
 * 굵기를 세 급으로 뚜렷하게 갈랐다 — 두꺼운 4개, 중간 5개, 실선 같은 얇은 것 6개.
 * 전부 비슷하면 그라디언트처럼 보이므로 급끼리 인접하지 않게 섞었다.
 *
 * 길이는 15개 전부 1.0 이다. 부채꼴 전체가 스테이지 대각선까지 균일하게 뻗고
 * 어느 쐐기도 중간에서 끝나지 않는다. 각도에 따라 프레임의 어느 변으로 나가는지만
 * 달라진다 — 위쪽은 상단 변, 가운데는 우측 변, 아래쪽은 하단 변이다.
 * 잘려 나가는 것은 의도된 동작이다(구분은 굵기와 톤이 담당한다).
 */
const WEDGES: readonly Wedge[] = [
  { angle: -30.0, lenD: 1.0, halfD: 0.0032, tone: 'soft', delay: 0 },
  // 아래쪽 네 개(-30 ~ -9)는 하단 변으로 빠져나가 제목 블록 위를 지난다.
  // 스테이지 안에서 끝나게 하려면 각각 0.382 / 0.535 이하로 잡아야 하지만,
  // 지금은 그 대신 Hero.astro 의 .title-block::before 가 제목선부터 불투명한
  // 흰색이어서 글자 위로 넘어온 부분을 덮는다. 그 배경을 반투명으로 되돌리면
  // gold 로고와 주황 쐐기의 휘도가 겹쳐(실측 1.01:1) 글자 경계가 사라진다.
  { angle: -22.0, lenD: 1.0, halfD: 0.0167, tone: 'orange', delay: 34 },
  { angle: -15.5, lenD: 1.0, halfD: 0.0389, tone: 'orange', delay: 12 },
  { angle: -9.0, lenD: 1.0, halfD: 0.0026, tone: 'soft', delay: 62 },
  { angle: -2.5, lenD: 1.0, halfD: 0.0195, tone: 'soft', delay: 22 },
  { angle: 4.0, lenD: 1.0, halfD: 0.0361, tone: 'orange', delay: 6 },
  { angle: 11.5, lenD: 1.0, halfD: 0.0042, tone: 'orange', delay: 74 },
  { angle: 19.0, lenD: 1.0, halfD: 0.0148, tone: 'soft', delay: 30 },
  { angle: 27.5, lenD: 1.0, halfD: 0.0306, tone: 'soft', delay: 18 },
  { angle: 36.0, lenD: 1.0, halfD: 0.003, tone: 'orange', delay: 84 },
  { angle: 44.0, lenD: 1.0, halfD: 0.0185, tone: 'orange', delay: 44 },
  { angle: 52.5, lenD: 1.0, halfD: 0.0334, tone: 'soft', delay: 26 },
  { angle: 61.0, lenD: 1.0, halfD: 0.0022, tone: 'orange', delay: 90 },
  { angle: 68.0, lenD: 1.0, halfD: 0.0157, tone: 'soft', delay: 52 },
  { angle: 74.0, lenD: 1.0, halfD: 0.0037, tone: 'orange', delay: 68 },
];

/** 쐐기 중 가장 두꺼운 것의 halfD. 호흡 주기를 굵기에 비례시키는 기준이다. */
const MAX_HALF = Math.max(...WEDGES.map((w) => w.halfD));

/**
 * 뻗기가 끝난 뒤의 상시 호흡 파라미터.
 *
 * 굵은 쐐기는 느리게, 얇은 쐐기는 빠르게 숨쉰다. 전부 같은 주기로 흔들면
 * 레이어 전체가 한 덩어리로 깜빡여서 빛이 아니라 화면 밝기 변화로 읽힌다.
 * 위상도 각도에서 결정론적으로 뽑아 흩어 놓는다. 난수를 쓰지 않는다.
 */
const breathe = (w: Wedge) => {
  const dur = +(5.0 + (w.halfD / MAX_HALF) * 3.0).toFixed(2);
  const phase = +(((Math.round(Math.abs(w.angle) * 10) * 7) % 31) / 31) * dur;
  // 자기 쐐기의 뻗기가 끝난 뒤부터 숨쉰다.
  const grown = (TIMING.rayStart + w.delay + TIMING.rayDur) / 1000;
  return { dur, delay: +(grown + phase).toFixed(2) };
};

const wedgeStyle = (w: Wedge) => {
  const b = breathe(w);
  return [
    `--lenD:${w.lenD}`,
    `--halfD:${w.halfD}`,
    // 화면 y 는 아래로 증가한다. 우상향이므로 부호를 뒤집는다.
    `--rot:${(-w.angle).toFixed(2)}deg`,
    // 쐐기별 지연에 레이어 공통 시작 시각을 더한다. 실루엣이 먼저 서고
    // 그 다음에 광선이 뻗어야 인과가 읽힌다.
    `--d:${TIMING.rayStart + w.delay}ms`,
    `--breatheDur:${b.dur}s`,
    `--breatheDelay:${b.delay}s`,
  ].join(';');
};
---

{/* 광선 — transform-origin 을 원점에 두고 scaleX 로 뻗는다. 오브젝트보다 먼저다. */}
<div class="rays">
  {
    WEDGES.map((w) => (
      // 바깥 겹: 회전만. 안쪽 겹: scaleX 로 뻗기만.
      <div class="ray" style={wedgeStyle(w)}>
        <div
          class:list={['ray__beam', w.tone === 'soft' ? 'ray__beam--soft' : 'ray__beam--orange']}
          data-anim
        />
      </div>
    ))
  }
</div>

<style
  define:vars={{
    ox: `${ORIGIN.xPct}`,
    oy: `${ORIGIN.yPct}`,
    rayDur: `${TIMING.rayDur}ms`,
  }}
>
  /* 컴포넌트 스코프 스타일은 별도 CSS 엔트리다. 디자인 토큰을 theme() 으로
     쓰려면 설정을 들고 있는 global.css 를 참조로 걸어야 한다. */
  @reference '../styles/global.css';

  .rays {
    position: absolute;
    inset: 0;
    /* 기준 길이 = 컨테이너 실제 대각선.
       세로 항을 58cqw 로 제한한다. 가로로 넓은 스테이지(데스크톱: 100cqh 가
       36~44cqw)에서는 min 이 100cqh 를 그대로 골라 아무 영향이 없고, 세로로 긴
       스테이지(모바일 세로: 100cqh 가 140cqw)에서만 작동해 먼 오브젝트가
       프레임 완전히 밖으로 밀려나 보이지 않게 되는 것을 막는다. */
    --diag: hypot(100cqw, min(100cqh, 58cqw));
  }

  /* 쐐기 한 겹: 꼭짓점을 원점에 두고 +x 방향으로 놓은 뒤 회전시킨다. */
  .ray {
    position: absolute;
    left: calc(var(--ox) * 1cqw);
    top: calc(var(--oy) * 1cqh);
    width: calc(var(--lenD) * var(--diag));
    height: calc(2 * var(--halfD) * var(--diag));
    margin-top: calc(-1 * var(--halfD) * var(--diag));
    transform-origin: 0 50%;
    rotate: var(--rot);
  }

  .ray__beam {
    width: 100%;
    height: 100%;
    /* 원점 쪽이 진하고 끝단은 0.35 까지만 내려간다. 흰색으로 페이드시키지 않는다. */
    background: linear-gradient(to right, var(--c-strong), var(--c-weak));
    /* 원점에서 한 점으로 모이는 쐐기 */
    clip-path: polygon(0 50%, 100% 0, 100% 100%);
    transform-origin: 0 50%;
    /*
     * A3 — 뻗기(ray-grow) 뒤에 상시 호흡(ray-breathe)을 잇는다.
     *
     * 둘 다 opacity 를 쓰지만 구간이 겹치지 않는다. ray-breathe 의 지연이
     * ray-grow 의 종료(지연 + rayDur) 이후이고, 지연 중에는 fill 이 없어
     * 아무것도 기여하지 않는다. 겹치더라도 목록 뒤쪽이 우선하므로 안전하다.
     *
     * 각도·굵기·길이·색은 건드리지 않는다. 밝기만 얕게 흔든다.
     */
    animation:
      ray-grow var(--rayDur) cubic-bezier(0.16, 0.84, 0.3, 1) var(--d) both,
      ray-breathe var(--breatheDur) ease-in-out var(--breatheDelay) infinite;
    will-change: transform, opacity;
  }

  .ray__beam--orange {
    --c-strong: color-mix(in srgb, theme(colors.orange) 85%, transparent);
    --c-weak: color-mix(in srgb, theme(colors.orange) 35%, transparent);
  }

  .ray__beam--soft {
    --c-strong: color-mix(in srgb, theme(colors.orange-soft) 88%, transparent);
    --c-weak: color-mix(in srgb, theme(colors.orange-soft) 38%, transparent);
  }

  @keyframes ray-grow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: none;
    }
  }

  /* 1 에서 시작해 1 로 끝난다. 뻗기가 끝난 밝기에서 튀지 않고 이어진다. */
  @keyframes ray-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.85;
    }
  }

  /* 뷰포트 640px 이하 — 뻗기는 살리고 상시 호흡만 끈다.
     (이유는 Hero.astro 의 같은 미디어쿼리 주석 참조.)
     animation-name 을 하나로 줄이면 첫 값들만 남아 ray-grow 만 돈다. */
  @media (max-width: 640px) {
    .ray__beam {
      animation-name: ray-grow;
    }
  }

  /* 애니메이션 없이 최종 상태를 즉시 렌더한다.
     animation 을 통째로 none 으로 덮으므로 상시 호흡도 함께 꺼진다.
     640px 분기보다 뒤에 와야 한다 — 특이도가 같아 순서로 승부가 갈린다. */
  @media (prefers-reduced-motion: reduce) {
    .ray__beam {
      animation: none;
      will-change: auto;
    }
  }
</style>
