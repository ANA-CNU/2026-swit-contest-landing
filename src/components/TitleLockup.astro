<style>
  @reference '../styles/global.css';

  /*
   * transform 속성(글자 위치)은 그대로 두고 translate 만 애니메이션한다.
   * 단위는 px 이며 SVG 안에서는 사용자 단위와 같다. viewBox 높이가 120 정도라
   * 26px 은 글자 높이의 약 20% 다.
   */
  svg path {
    animation: glyph-in var(--gdur, 0ms) cubic-bezier(0.2, 0.9, 0.3, 1) var(--gd, 0ms) both;
  }

  @keyframes glyph-in {
    from {
      opacity: 0;
      translate: 0 26px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* 애니메이션 없이 최종 상태를 즉시 렌더한다. */
  @media (prefers-reduced-motion: reduce) {
    svg path {
      animation: none;
    }
  }

</style>
