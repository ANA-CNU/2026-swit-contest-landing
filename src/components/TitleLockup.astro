---
/**
 * SW-IT CONTEST 제목 락업.
 *
 * 포스터 서체 CDR제스트는 라이선스가 웹폰트/임베딩을 제외하므로 @font-face 로
 * 배포할 수 없다. 따라서 아웃라인 패스만 인라인한다.
 * 패스는 asset/SOURCE_title/title_swit.svg, title_contest.svg 에서 추출했다.
 * 원본 SVG 에는 글자 뒤에 부드러운 그림자용 base64 PNG 레이어(합계 248KB,
 * 단색 검정 + 최대 알파 24%)가 mask/filter 로 얹혀 있었다. 초기 HTML 을
 * 248KB 늘릴 값이 없어 버렸고, 글리프는 전부 이 패스에 들어 있다.
 * <text> 나 폰트 참조는 없다. 색은 currentColor 로 받는다.
 */
interface Props {
  line: 'swit' | 'contest';
  class?: string;
  /** 첫 글자가 등장하는 시각(ms). 생략하면 애니메이션 없이 그냥 보인다. */
  delay?: number;
  /** 글자 하나의 등장 시간(ms). */
  dur?: number;
  /** 글자 사이 간격(ms). */
  stagger?: number;
}
const { line, class: className = '', delay, dur = 300, stagger = 24 } = Astro.props;

/*
 * 글자별 등장.
 *
 * 줄 전체를 한 덩어리로 띄우면 로고가 "나타난다". 글리프를 조금씩 밀면
 * "쓰인다". 새 에셋도 새 DOM 도 필요 없다 — 아웃라인 패스가 이미 글자 단위로
 * 쪼개져 있다(SW-IT 5개, CONTEST 7개).
 *
 * 주의: 각 <path> 에는 글자 위치를 잡는 transform 속성이 이미 붙어 있다.
 * CSS transform 으로 애니메이션하면 그 속성을 덮어써서 글자가 전부 겹친다.
 * 그래서 개별 translate 속성만 쓴다. translate 는 transform 보다 먼저
 * 합성되므로 속성 transform 을 건드리지 않고 바깥에서 밀어 올린다.
 */
const animated = typeof delay === 'number';
const glyphStyle = (i: number) =>
  animated
    ? `--gd:${delay + i * stagger}ms;--gdur:${dur}ms`
    : undefined;
